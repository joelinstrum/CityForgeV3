}

.building-card-name {
    color: rgb(244, 239, 218);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.building-card-meta {
    margin-top: 2px;
    color: rgb(193, 181, 145);
    font-size: 7px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.catalog-meta {
    margin-bottom: 16px;
    color: var(--cf-paper-300);
    font-size: 9px;
    letter-spacing: 1px;
}

.lighting-lab,
.context-panel {
    position: absolute;
    left: 104px;
    top: 92px;
    width: 390px;
    padding: 14px 16px;
    background-color: rgba(19, 28, 35, 0.95);
    border-width: 1px;
    border-color: rgba(193, 155, 72, 0.34);
    border-radius: var(--cf-radius-md);
}

.lighting-lab .section-label {
    margin-bottom: 4px;
    -unity-text-align: upper-left;
}

.lighting-current {
    margin-bottom: 10px;
    color: var(--cf-paper-100);
    font-size: 17px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.time-actions {
    flex-direction: row;
}

.time-actions .cf-button {
    flex-grow: 1;
    height: 38px;
    margin-right: 5px;
    margin-bottom: 0;
    padding-left: 5px;
    padding-right: 5px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.weather-actions {
    flex-direction: row;
    margin-top: 7px;
    margin-bottom: 2px;
}

.weather-actions .cf-button {
    width: 38px;
    height: 38px;
    margin-right: 5px;
    font-size: 20px;
    -unity-text-align: middle-center;
}

.cf-button--time-selected {
    background-color: rgb(122, 89, 48);
    border-color: var(--cf-brass-300);
    color: rgb(255, 244, 210);
}

.lighting-note {
    margin-top: 10px;
    color: var(--cf-paper-300);
    font-size: 8px;
    letter-spacing: 1px;
