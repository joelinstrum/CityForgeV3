:root {
    --cf-ink-950: rgb(12, 18, 23);
    --cf-ink-900: rgb(19, 28, 35);
    --cf-ink-800: rgb(30, 43, 51);
    --cf-ink-700: rgb(46, 61, 69);
    --cf-paper-100: rgb(238, 231, 207);
    --cf-paper-300: rgb(197, 187, 156);
    --cf-brass-400: rgb(193, 155, 72);
    --cf-brass-300: rgb(224, 188, 103);
    --cf-green-500: rgb(71, 111, 82);
    --cf-danger-500: rgb(155, 67, 55);
    --cf-space-1: 4px;
    --cf-space-2: 8px;
    --cf-space-3: 12px;
    --cf-space-4: 16px;
    --cf-space-6: 24px;
    --cf-space-8: 32px;
    --cf-space-12: 48px;
    --cf-radius-sm: 3px;
    --cf-radius-md: 7px;
}

.app-root,
.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--cf-paper-100);
}

.splash-screen {
    background-color: black;
}

.splash-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 44px;
}

.splash-prompt {
    color: rgba(238, 231, 207, 0.82);
    font-size: 13px;
    letter-spacing: 4px;
    padding: 10px 18px;
    background-color: rgba(12, 18, 23, 0.72);
    border-bottom-color: var(--cf-brass-400);
    border-bottom-width: 1px;
}

.main-menu-screen {
    background-color: var(--cf-ink-950);
    -unity-background-scale-mode: scale-and-crop;
}

.menu-logo {
    position: absolute;
    left: 34px;
    top: 18px;
    width: 820px;
    height: 316px;
    -unity-background-scale-mode: scale-to-fit;
}

.menu-stack {
    position: absolute;
    left: 88px;
    top: 338px;
    width: 505px;
}

.region-editor-screen {
    overflow: hidden;
    background-color: rgb(8, 14, 19);
}

.region-manage-overlay {
    background-color: rgba(3, 7, 10, 0.72);
}

.region-manage-panel {
    position: relative;
    width: 1152px;
    height: 1024px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cf-image-button--region-manage-action {
    position: absolute;
    width: 465px;
    height: 132px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.62;
    transition-property: scale, opacity;
    transition-duration: 0.14s;
}

.cf-image-button--region-manage-action:hover {
    opacity: 1;
}

.region-manage-action--load {
    left: 84px;
    top: 600px;
}

.region-manage-action--create {
    left: 603px;
    top: 600px;
}

.region-manage-close {
    position: absolute;
    right: 26px;
    top: 30px;
    width: 84px;
    height: 112px;
    padding: 0;
    margin: 0;
    color: transparent;
    background-color: transparent;
    border-width: 0;
}

.region-manage-close:hover {
    background-color: rgba(255, 232, 142, 0.12);
    border-radius: 56px;
}

.open-region-panel {
    position: relative;
    width: 1450px;
    height: 1120px;
    max-width: 92%;
    max-height: 90%;
    padding: 26px 34px 28px 34px;
    flex-shrink: 0;
    background-color: rgb(4, 39, 73);
    border-width: 5px;
    border-color: rgb(210, 155, 43);
    border-radius: 14px;
}

.open-region-title {
    height: 78px;
    flex-shrink: 0;
    margin-bottom: 18px;
    padding-left: 26px;
    padding-right: 96px;
    color: rgb(255, 245, 214);
    background-color: rgb(3, 48, 88);
    border-bottom-width: 3px;
    border-bottom-color: rgb(216, 163, 52);
    font-size: 34px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.open-region-panel .region-save-list {
    position: relative;
    left: auto;
    top: auto;
    width: auto;
    height: auto;
    max-height: none;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-right: 14px;
    overflow: hidden;
}

.open-region-panel .region-save-list .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.open-region-panel .region-save-list .unity-scroller--vertical {
    width: 18px;
    min-width: 18px;
}

.open-region-panel .region-save-entry {
    min-height: 90px;
    height: 90px;
    margin-bottom: 9px;
    padding: 8px 14px 8px 8px;
    flex-shrink: 0;
    background-color: rgba(3, 27, 55, 0.84);
    border-width: 2px;
    border-color: rgb(207, 155, 49);
    border-radius: 5px;
}

.open-region-panel .region-save-entry:hover {
    background-color: rgba(8, 67, 119, 0.94);
    border-color: rgb(71, 212, 255);
}

.region-save-preview {
    width: 132px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 16px;
    border-width: 2px;
    border-color: rgb(220, 170, 55);
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
}

.open-region-panel .region-save-entry-title {
    color: rgb(255, 246, 218);
    font-size: 22px;
    -unity-font-style: bold;
}

.open-region-panel .region-save-entry-meta {
    margin-top: 8px;
    color: rgb(230, 217, 184);
    font-size: 12px;
    letter-spacing: 0.5px;
}

.cf-button--region-load {
    width: 145px;
    height: 62px;
    min-height: 62px;
    flex-shrink: 0;
    margin: 0 0 0 12px;
    color: rgb(255, 239, 194);
    background-color: rgb(4, 48, 94);
    border-width: 3px;
    border-color: rgb(221, 169, 55);
    border-radius: 5px;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.cf-button--region-load:hover {
    color: white;
    background-color: rgb(8, 89, 159);
    border-color: rgb(255, 212, 91);
}

.cf-image-button--region-cancel {
    position: relative;
    left: auto;
    top: auto;
    align-self: center;
    width: 300px;
    height: 100px;
    flex-shrink: 0;
    margin-top: 10px;
    opacity: 0.72;
}

.cf-image-button--region-cancel:hover {
    opacity: 1;
}

.open-region-close {
    position: absolute;
    right: 36px;
    top: 30px;
    width: 72px;
    height: 72px;
    margin: 0;
    padding: 0;
    color: rgb(255, 243, 207);
    background-color: rgb(3, 48, 88);
    border-width: 3px;
    border-color: rgb(216, 163, 52);
    border-radius: 56px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.open-region-close:hover {
    color: white;
    background-color: rgb(7, 78, 132);
    border-color: rgb(255, 218, 106);
}

.open-region-empty {
    flex-grow: 1;
    justify-content: center;
    color: rgb(235, 220, 181);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.region-header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 86px;
    flex-shrink: 0;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 18, 23, 0.86);
    border-bottom-width: 2px;
    border-bottom-color: var(--cf-brass-400);
}

.region-header > .cf-button {
    width: 190px;
    margin-bottom: 0;
}

.region-title-group {
    flex-grow: 1;
    padding-left: 24px;
}

.region-title {
    color: var(--cf-paper-100);
    font-size: 25px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.region-subtitle {
    color: var(--cf-paper-300);
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 4px;
}

.region-map-scroll {
    position: absolute;
    left: 0;
    right: 0;
    top: 86px;
    bottom: 0;
    background-color: rgb(35, 43, 65);
}

.region-map-scroll .unity-scroll-view__content-container {
    padding: 0;
}

.region-map {
    position: relative;
    overflow: hidden;
    background-color: rgb(39, 47, 70);
}

.region-map-projection {
    position: absolute;
    left: 0;
    top: 0;
    scale: 1 0.3420201433;
    transform-origin: 0 0;
}

.region-map-plane {
    position: absolute;
    /* Match the district camera: +X goes upper-right, +Z upper-left.
       UI Y grows downward, so reflect it before the isometric rotation. */
    rotate: -45deg;
    scale: 1 -1;
    transform-origin: 50% 50%;
}

.region-map-slab {
    background-color: rgb(24, 29, 27);
    border-width: 12px;
    border-color: rgb(28, 33, 31);
}

.region-map-grass {
    /* Sampled from the default district grass texture; matches DefaultGrassColor. */
    background-color: rgb(73, 89, 36);
    border-width: 6px;
    border-color: rgb(88, 96, 76);
    overflow: hidden;
}

.region-grass-patch {
    position: absolute;
    -unity-background-scale-mode: scale-and-crop;
}

.region-city-tile {
    padding: 0;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-color: rgba(218, 230, 198, 0.24);
    border-radius: 0;
}

.region-city-tone-0 { background-color: rgba(62, 91, 48, 0.08); }
.region-city-tone-1 { background-color: rgba(81, 108, 61, 0.08); }
.region-city-tone-2 { background-color: rgba(97, 117, 65, 0.08); }
.region-city-tone-3 { background-color: rgba(58, 86, 45, 0.08); }

.region-city-tile:hover,
.region-city-tile--selected {
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(230, 215, 135, 0.75);
    background-color: rgba(122, 139, 67, 0.18);
}

.region-place-marker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.region-place-name {
    color: rgb(239, 236, 215);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.region-district-name {
    font-size: 13px;
    letter-spacing: 2px;
    opacity: 0.42;
}

.region-town-marker {
    padding-top: 2px;
}

.region-town-name {
    position: absolute;
    bottom: 52%;
    font-size: 12px;
    letter-spacing: 1px;
    opacity: 0.92;
}

.region-town-dot {
    width: 7px;
    height: 7px;
    margin-top: 12px;
    background-color: rgb(244, 226, 161);
    border-width: 1px;
    border-color: rgb(35, 43, 38);
    border-radius: 4px;
}

.region-info-card {
    position: absolute;
    left: 30px;
    bottom: 38px;
    width: 360px;
    min-height: 116px;
    padding: 18px 22px;
    background-color: rgba(216, 229, 218, 0.94);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.66);
}

.region-card-kicker {
    color: rgb(48, 67, 78);
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.region-card-name {
    color: rgb(24, 40, 49);
    font-size: 23px;
    margin-top: 5px;
    -unity-font-style: bold;
}

.region-card-meta {
    color: rgb(52, 73, 82);
    font-size: 11px;
    letter-spacing: 1px;
    margin-top: 8px;
}

.district-terraform-screen {
    overflow: hidden;
    background-color: rgba(32, 40, 61, 0);
}

.district-terraform-viewport {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgba(35, 43, 65, 0);
}

.district-terraform-projection {
    position: absolute;
    left: 50%;
    top: 46%;
    scale: 1 0.342;
    transform-origin: 0 0;
    overflow: visible;
}

.district-terraform-plane {
    position: absolute;
    rotate: 45deg;
    transform-origin: 50% 50%;
}

.district-terraform-slab {
    margin-top: 26px;
    background-color: rgb(24, 29, 27);
    border-width: 12px;
    border-color: rgb(28, 33, 31);
}

.district-terraform-grass {
    overflow: hidden;
    background-color: rgb(74, 104, 57);
    background-repeat: repeat;
    border-width: 6px;
    border-color: rgb(88, 96, 76);
}

.district-terraform-grass.district-grass-lod0 { background-size: 4px 4px; }
.district-terraform-grass.district-grass-lod1 { background-size: 6px 6px; }
.district-terraform-grass.district-grass-lod2 { background-size: 10px 10px; }
.district-terraform-grass.district-grass-lod3 { background-size: 24px 24px; }
.district-terraform-grass.district-grass-lod4 { background-size: 32px 32px; }
.district-terraform-grass.district-grass-lod5 { background-size: 48px 48px; }

.terraform-grid-line {
    position: absolute;
}

.terraform-grid-line--minor {
    background-color: rgba(226, 235, 205, 0.10);
}

.terraform-grid-line--major {
    background-color: rgba(226, 235, 205, 0.22);
}

.cf-button--terraform-back {
    position: absolute;
    left: 28px;
    top: 24px;
    width: 150px;
    margin: 0;
    background-color: rgba(7, 29, 48, 0.82);
    border-color: rgba(222, 180, 73, 0.82);
}

.district-mode-switch {
    position: absolute;
    left: 194px;
    top: 24px;
    height: 42px;
    padding: 3px;
    flex-direction: row;
    background-color: rgba(7, 29, 48, 0.88);
    border-width: 1px;
    border-color: rgba(222, 180, 73, 0.72);
    border-radius: 21px;
}

.district-mode-button {
    width: 126px;
    height: 34px;
    margin: 0 2px;
    padding: 0;
    color: rgba(235, 241, 255, 0.72);
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 17px;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.district-mode-button:hover {
    color: white;
    background-color: rgba(67, 101, 172, 0.72);
}

.district-mode-button--selected {
    color: white;
    background-color: rgb(41, 104, 116);
    border-color: rgb(38, 238, 104);
}

.district-mode-button--selected#district-mode-builder {
    background-color: rgb(104, 72, 36);
    border-color: rgb(244, 190, 62);
}

.terraform-rail {
    position: absolute;
    left: 28px;
    top: 150px;
    width: 92px;
    padding: 12px 9px;
    align-items: center;
    background-color: rgba(220, 233, 224, 0.62);
    border-radius: 44px;
}

.terraform-rail--builder {
    background-color: rgba(226, 214, 184, 0.68);
}

.terraform-category-button {
    width: 72px;
    height: 72px;
    margin-bottom: 12px;
    padding: 0;
    color: rgb(235, 241, 255);
    background-color: rgb(49, 75, 137);
    border-width: 4px;
    border-color: rgb(192, 160, 92);
    border-radius: 36px;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.terraform-category-button:hover {
    background-color: rgb(67, 101, 172);
    border-color: rgb(243, 216, 117);
    scale: 1.06 1.06;
}

.terraform-category-button--selected {
    background-color: rgb(41, 104, 116);
    border-color: rgb(38, 238, 104);
}

.terraform-flyout {
    position: absolute;
    left: 132px;
    top: 146px;
    width: 112px;
    padding: 9px;
    align-items: center;
    background-color: rgba(8, 86, 43, 0.97);
    border-width: 2px;
    border-color: rgba(80, 241, 116, 0.9);
    border-radius: 24px;
}

.terraform-flyout--builder {
    background-color: rgba(76, 45, 15, 0.98);
    border-color: rgba(244, 190, 62, 0.94);
}

.terraform-flyout-title {
    margin-top: 2px;
    margin-bottom: 8px;
    color: rgb(239, 255, 235);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.district-road-family-card {
    width: auto;
    min-height: 132px;
    margin: 0 12px 14px 0;
    padding: 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(25, 48, 67, 0.96);
    border-width: 2px;
    border-color: rgba(194, 153, 67, 0.75);
    border-radius: 8px;
    color: rgb(244, 239, 215);
}

.district-road-family-card--selected {
    background-color: rgba(67, 116, 82, 0.98);
    border-color: rgb(99, 229, 135);
}

.district-road-family-preview {
    width: 150px;
    height: 108px;
    flex-shrink: 0;
    background-size: cover;
    border-width: 1px;
    border-color: rgba(244, 239, 215, 0.8);
}

.district-road-family-copy {
    flex-grow: 1;
    margin-left: 18px;
}

.district-road-family-name {
    font-size: 21px;
    white-space: normal;
    color: rgb(244, 239, 215);
}

.district-road-family-price {
    margin-top: 7px;
    font-size: 15px;
    color: rgb(236, 198, 92);
}

.district-road-family-modal {
    width: 820px;
    height: 650px;
    max-width: 88%;
    max-height: 86%;
    padding: 28px 34px 24px 34px;
    background-color: rgba(7, 29, 48, 0.98);
    border-width: 3px;
    border-color: rgb(222, 180, 73);
    border-radius: 22px;
}

.district-road-family-title {
    color: rgb(248, 239, 208);
    font-size: 31px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.district-road-family-intro {
    margin: 10px 22px 20px 22px;
    color: rgb(190, 207, 216);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.district-road-family-list {
    flex-grow: 1;
    min-height: 0;
    padding: 4px 8px;
}

.district-road-family-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 14px;
}

.district-road-family-actions .cf-button {
    width: 220px;
    margin: 0;
}

.terraform-tool-button {
    width: 82px;
    height: 64px;
    margin-bottom: 8px;
    padding: 0;
    color: rgb(237, 242, 255);
    background-color: rgb(50, 73, 126);
    border-width: 2px;
    border-color: rgb(19, 40, 64);
    border-radius: 9px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.terraform-tool-button:hover {
    color: white;
    background-color: rgb(67, 100, 164);
    border-color: rgb(220, 178, 74);
}

.terraform-tool-button--selected,
.terraform-tool-button--selected:hover {
    color: white;
    background-color: rgb(48, 119, 112);
    border-color: rgb(80, 232, 151);
}

.terraform-hud {
    position: absolute;
    left: 22px;
    bottom: 20px;
    width: 330px;
    min-height: 190px;
    padding: 16px;
    background-color: rgba(185, 209, 218, 0.94);
    border-width: 4px;
    border-color: rgba(238, 247, 241, 0.92);
    border-radius: 34px;
}

.district-info-toggle,
.district-interface-toggle,
.district-edge-pan {
    position: absolute;
    color: rgb(240, 244, 244);
    background-color: rgba(7, 29, 48, 0.78);
    border-width: 2px;
    border-color: rgba(222, 180, 73, 0.82);
    border-radius: 7px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.district-info-toggle {
    left: 22px;
    bottom: 20px;
    width: 64px;
    height: 34px;
    font-size: 11px;
}

.district-info-close {
    position: absolute;
    right: 12px;
    top: 10px;
    width: 28px;
    height: 28px;
    padding: 0;
    color: rgb(55, 78, 88);
    background-color: rgba(235, 245, 238, 0.72);
    border-width: 1px;
    border-color: rgba(55, 78, 88, 0.45);
    border-radius: 6px;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.district-interface-toggle {
    right: 18px;
    top: 18px;
    width: 82px;
    height: 34px;
    font-size: 10px;
}

.district-edge-pan {
    width: 38px;
    height: 38px;
    opacity: 0.48;
}

.district-edge-pan:hover {
    opacity: 1;
    background-color: rgba(31, 92, 101, 0.94);
    border-color: rgb(80, 232, 151);
}

.district-edge-pan {
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 16px;
}

.district-edge-pan--left {
    left: 7px;
    top: 48%;
}

.district-edge-pan--right {
    right: 7px;
    top: 48%;
}

.district-edge-pan--top {
    top: 7px;
    left: 49%;
}

.district-edge-pan--bottom {
    bottom: 7px;
    left: 49%;
}

.terraform-minimap {
    width: 138px;
    height: 92px;
    margin-bottom: 10px;
    background-color: rgb(51, 112, 38);
    border-width: 5px;
    border-color: rgb(235, 245, 238);
    -unity-background-scale-mode: scale-and-crop;
}

.terraform-district-name {
    color: rgb(25, 46, 60);
    font-size: 22px;
    -unity-font-style: bold;
}

.terraform-info-kicker {
    color: rgb(55, 78, 88);
    font-size: 9px;
    letter-spacing: 2px;
