}

.source-label {
    margin-top: 12px;
    margin-bottom: 6px;
    color: var(--cf-paper-300);
    font-size: 8px;
    letter-spacing: 1px;
}

.source-actions {
    flex-direction: row;
}

.source-actions .cf-button {
    flex-grow: 1;
    height: 34px;
    margin-right: 5px;
    margin-bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.cf-button--source-selected {
    background-color: rgb(53, 99, 86);
    border-color: var(--cf-brass-300);
    color: rgb(245, 236, 205);
}

.section-label {
    margin-bottom: 10px;
    color: var(--cf-brass-300);
    font-size: 9px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.inspector {
    position: absolute;
    right: 18px;
    top: 92px;
    width: 306px;
    padding: 20px;
    background-color: rgba(19, 28, 35, 0.95);
    border-width: 1px;
    border-color: rgba(193, 155, 72, 0.34);
    border-radius: var(--cf-radius-md);
}

.inspector-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: -10px -10px 10px -10px;
}

.inspector-drag-handle {
    flex-grow: 1;
    height: 28px;
    padding-left: 8px;
    color: var(--cf-paper-300);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.inspector-header .cf-button {
    width: 30px;
    min-width: 30px;
    height: 28px;
    margin: 0;
    padding: 0;
    font-size: 18px;
}

.inspector-reopen {
    position: absolute;
    right: 18px;
    top: 92px;
    width: 112px;
}

.inspector .section-label {
    -unity-text-align: upper-left;
}

.inspector-title {
    margin-bottom: 12px;
    font-size: 20px;
    -unity-font-style: bold;
}

.facing-indicator {
    margin-bottom: 12px;
    padding: 12px;
    background-color: rgba(71, 111, 82, 0.72);
    border-left-width: 3px;
    border-left-color: var(--cf-brass-300);
}

.facing-heading {
    color: rgb(255, 244, 210);
    font-size: 16px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.facing-degrees {
    margin-top: 3px;
    color: var(--cf-paper-300);
    font-size: 8px;
    letter-spacing: 1px;
}

.property-row {
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: rgba(197, 187, 156, 0.14);
}

.property-key {
    width: 105px;
    color: var(--cf-paper-300);
    font-size: 9px;
    letter-spacing: 1px;
}

.property-value {
    flex-grow: 1;
    font-size: 11px;
}

.inspector-note {
    margin-top: 18px;
    padding: 12px;
    color: var(--cf-paper-300);
    background-color: rgba(46, 61, 69, 0.52);
    font-size: 11px;
    white-space: normal;
}

.status-note {
    margin-top: 12px;
    padding: 9px;
    color: var(--cf-brass-300);
    background-color: rgba(12, 18, 23, 0.72);
    font-size: 10px;
    white-space: normal;
}

.inspector-actions {
    flex-direction: row;
    margin-top: 12px;
}

.inspector-actions .cf-button {
    flex-grow: 1;
    margin-right: 6px;
    margin-bottom: 0;
}

.lot-orbit-dial {
    position: relative;
    align-self: center;
    width: 180px;
    height: 180px;
    margin-top: 8px;
    margin-bottom: 12px;
    background-color: rgba(8, 18, 24, 0.72);
    border-width: 2px;
    border-color: rgba(91, 181, 201, 0.35);
    border-radius: 90px;
}

.lot-orbit-dial .cf-button--orbit-segment,
.lot-orbit-dial .cf-button--orbit-segment-selected {
    min-width: 0;
    min-height: 0;
    padding: 0;
    margin: 0;
    border-width: 2px;
    border-radius: 21px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.lot-orbit-dial .cf-button--orbit-segment {
    color: var(--cf-paper-200);
    background-color: rgba(28, 45, 55, 0.96);
    border-color: rgba(91, 181, 201, 0.48);
}

.lot-orbit-dial .cf-button--orbit-segment:hover {
    color: rgb(241, 246, 247);
    background-color: rgba(50, 92, 105, 0.98);
    border-color: rgb(100, 215, 235);
}

.lot-orbit-dial .cf-button--orbit-segment-selected {
    color: rgb(8, 22, 27);
    background-color: rgb(102, 211, 229);
    border-color: rgb(207, 249, 255);
}

.lot-orbit-center {
    position: absolute;
    left: 57px;
    top: 64px;
    width: 66px;
    height: 52px;
    padding-top: 8px;
    color: var(--cf-paper-100);
    background-color: rgba(13, 28, 35, 0.98);
    border-width: 1px;
    border-color: rgba(193, 155, 72, 0.65);
    border-radius: 26px;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.viewport-hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    padding: 9px 15px;
    color: rgba(238, 231, 207, 0.72);
    background-color: rgba(12, 18, 23, 0.78);
    border-radius: var(--cf-radius-sm);
    font-size: 9px;
    letter-spacing: 1px;
}

.document-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 10, 14, 0.78);
}

.document-modal-panel {
    width: 520px;
    max-height: 720px;
    padding: 24px;
    background-color: rgb(19, 28, 35);
    border-width: 1px;
    border-color: rgba(193, 155, 72, 0.72);
    border-radius: var(--cf-radius-md);
}

.document-modal-panel.load-lot-modal-panel {
    height: 720px;
    max-height: 88%;
}

.document-modal-title {
    color: var(--cf-paper-100);
    font-size: 22px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.document-modal-copy {
    margin-top: 8px;
    margin-bottom: 16px;
    color: var(--cf-paper-300);
    font-size: 11px;
    white-space: normal;
}

.document-field {
    margin-top: 8px;
    color: var(--cf-paper-100);
}

.document-field .unity-base-field__label {
    width: 145px;
    color: var(--cf-brass-300);
    font-size: 9px;
    letter-spacing: 1px;
}

.document-field .unity-base-field__input {
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    color: var(--cf-paper-100);
    background-color: rgb(29, 44, 53);
    border-width: 1px;
    border-color: rgba(197, 187, 156, 0.24);
}

.document-field .unity-base-popup-field__input {
    min-height: 38px;
    padding-left: 12px;
    padding-right: 10px;
    background-color: rgb(29, 44, 53);
    border-width: 1px;
    border-color: rgba(215, 173, 75, 0.52);
    border-radius: 2px;
}

.document-field .unity-base-popup-field__text {
    color: var(--cf-paper-100);
    font-size: 12px;
    -unity-font-style: bold;
}

.document-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--cf-brass-300);
}

.unity-base-dropdown__container-outer {
    max-height: 280px;
    padding: 4px;
    background-color: rgb(14, 26, 33);
    border-width: 1px;
    border-color: var(--cf-brass-500);
    border-radius: 3px;
}

.unity-base-dropdown__container-inner {
    background-color: rgb(14, 26, 33);
}

.unity-base-dropdown__item {
    min-height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    color: var(--cf-paper-100);
    background-color: rgb(21, 36, 44);
}

.unity-base-dropdown__item:hover {
    color: var(--cf-paper-100);
    background-color: rgb(62, 91, 73);
}

.cf-choice-field {
    flex-shrink: 0;
}

.cf-choice-label {
    margin-bottom: 4px;
    color: var(--cf-brass-300);
    font-size: 9px;
    letter-spacing: 1px;
}

.cf-choice-display {
    min-height: 38px;
    padding-left: 0;
    padding-right: 0;
    color: var(--cf-paper-100);
    background-color: rgb(29, 44, 53);
    border-width: 1px;
    border-color: rgba(215, 173, 75, 0.58);
    border-radius: 2px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.cf-choice-display .unity-base-field__input,
.cf-choice-display .unity-base-popup-field__input {
    min-height: 38px;
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(248, 241, 217);
    background-color: rgb(29, 44, 53);
    border-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.cf-choice-display .unity-base-popup-field__text,
.cf-choice-display .unity-text-element {
    color: rgb(248, 241, 217);
    -unity-font-style: bold;
}

.cf-choice-display .unity-base-popup-field__arrow {
    width: 18px;
    min-width: 18px;
    margin-right: 8px;
    -unity-background-image-tint-color: rgb(230, 188, 91);
}

.cf-choice-display:hover,
.cf-choice-open .cf-choice-display {
    background-color: rgb(36, 55, 62);
    border-color: var(--cf-brass-300);
}

.cf-choice-display:hover .unity-base-field__input,
.cf-choice-display:hover .unity-base-popup-field__input,
.cf-choice-display:focus .unity-base-field__input,
.cf-choice-display:focus .unity-base-popup-field__input {
    background-color: rgb(36, 55, 62);
}

.cf-choice-menu {
    margin-top: 2px;
    padding: 4px;
    background-color: rgb(12, 23, 30);
    border-width: 1px;
    border-color: var(--cf-brass-500);
    border-radius: 3px;
}

.cf-choice-menu .unity-scroll-view__content-container {
    background-color: rgb(12, 23, 30);
}

.cf-choice-option {
    min-height: 32px;
    margin-bottom: 2px;
    padding-left: 10px;
    color: var(--cf-paper-100);
    background-color: rgb(21, 36, 44);
    border-width: 0;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.cf-choice-option:hover {
    color: var(--cf-paper-100);
    background-color: rgb(62, 91, 73);
}

.cf-cell-count-field {
    margin-top: 8px;
    flex-shrink: 0;
}

.cf-cell-count-choices {
    flex-direction: row;
    flex-wrap: wrap;
}

.cf-cell-count-option {
    width: 44px;
    height: 32px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 0;
    color: var(--cf-paper-100);
    background-color: rgb(29, 44, 53);
    border-width: 1px;
    border-color: rgba(215, 173, 75, 0.42);
    border-radius: 2px;
    font-size: 11px;
    -unity-font-style: bold;
}

.cf-cell-count-option:hover {
    background-color: rgb(36, 55, 62);
    border-color: var(--cf-brass-300);
}

.cf-cell-count-option.is-selected {
    color: var(--cf-paper-100);
    background-color: rgb(62, 91, 73);
    border-color: var(--cf-brass-300);
}

.document-modal-actions {
    flex-direction: row;
    margin-top: 20px;
}

.document-modal-actions .cf-button {
    flex-grow: 1;
    min-height: 40px;
    margin-right: 6px;
    margin-bottom: 0;
}

.lot-save-list {
    height: 420px;
    min-height: 120px;
    max-height: 420px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 4px;
    overflow: hidden;
}

.lot-save-list .unity-scroll-view__content-viewport {
    height: 420px;
    max-height: 420px;
    overflow: hidden;
}

.lot-save-list .unity-scroll-view__content-container {
    flex-shrink: 0;
}

.lot-save-list .unity-scroller--vertical {
    width: 18px;
    min-width: 18px;
}

.lot-save-entry {
    min-height: 62px;
    margin-bottom: 7px;
    padding: 10px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(29, 44, 53);
    border-width: 1px;
    border-color: rgba(197, 187, 156, 0.18);
}

.lot-save-thumbnail {
    width: 92px;
    height: 68px;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 18, 23);
    -unity-background-scale-mode: scale-to-fit;
}

.lot-save-thumbnail-empty {
    color: rgba(197, 187, 156, 0.45);
    font-size: 8px;
    letter-spacing: 1px;
}

.lot-save-details {
    flex-grow: 1;
}

.lot-save-entry-title {
    color: var(--cf-paper-100);
    font-size: 14px;
    -unity-font-style: bold;
}

.lot-save-entry-meta {
    margin-top: 5px;
    color: var(--cf-paper-300);
    font-size: 9px;
    letter-spacing: 1px;
}

.lot-save-entry-warning {
    margin-top: 5px;
    color: rgb(231, 132, 104);
    font-size: 8px;
    white-space: normal;
}

.lot-save-entry-actions {
    flex-direction: row;
    margin-top: 8px;
}

.lot-save-entry-actions .cf-button {
    min-height: 29px;
    margin-right: 5px;
    margin-bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 8px;
}

.road-inspector-section {
    margin-top: 6px;
    padding: 5px 7px 7px 7px;
    background-color: rgba(12, 23, 30, 0.72);
    border-width: 1px;
    border-color: rgba(197, 187, 156, 0.16);
    border-radius: 2px;
}

.road-inspector-section .unity-foldout__toggle {
    min-height: 27px;
    margin: 0;
    color: var(--cf-brass-300);
}

.road-inspector-section .unity-foldout__text {
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.road-inspector-section .unity-foldout__content {
    padding-left: 0;
    padding-right: 0;
}

.transit-inspector-section {
    margin-top: 6px;
    padding: 5px 7px 7px 7px;
    background-color: rgba(12, 23, 30, 0.72);
    border-width: 1px;
    border-color: rgba(197, 187, 156, 0.16);
    border-radius: 2px;
}

.transit-inspector-toggle {
    min-height: 30px;
    margin: 0;
    -unity-text-align: middle-left;
    color: var(--cf-brass-300);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.transit-inspector-content {
    padding-top: 5px;
}

.road-material-modal-panel {
    width: 720px;
    max-height: 760px;
}

.document-modal-panel.road-material-modal-panel.flora-modal-panel {
    height: 760px;
    max-height: 88%;
    overflow: hidden;
}

.building-prop-modal-panel {
    width: 820px;
    max-height: 780px;
}

.building-prop-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.building-prop-card {
    width: 360px;
    margin-right: 12px;
    margin-bottom: 12px;
    padding: 8px;
    background-color: rgb(21, 36, 44);
    border-width: 1px;
    border-color: rgba(197, 187, 156, 0.22);
}

.building-prop-thumbnail {
    height: 285px;
    margin-bottom: 8px;
    background-color: rgb(239, 238, 233);
    border-width: 1px;
    border-color: rgba(215, 173, 75, 0.55);
    -unity-background-scale-mode: scale-to-fit;
}

.building-prop-thumbnail:hover {
    border-width: 2px;
    border-color: rgb(96, 220, 133);
}

.building-prop-name {
    color: var(--cf-paper-100);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.road-material-list {
    max-height: 560px;
    margin-top: 8px;
    padding-right: 8px;
}

.road-material-role {
    margin-top: 12px;
    margin-bottom: 6px;
    color: var(--cf-paper-100);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.road-material-era {
    margin-top: 8px;
    margin-bottom: 4px;
    color: var(--cf-brass-300);
    font-size: 9px;
    letter-spacing: 1px;
}

.road-material-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.flora-modal-scroll {
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    padding-right: 8px;
}

.road-material-card {
    width: 150px;
    margin-right: 7px;
    margin-bottom: 8px;
    padding: 5px;
    background-color: rgb(21, 36, 44);
    border-width: 1px;
    border-color: rgba(197, 187, 156, 0.16);
}

.road-material-swatch {
    height: 72px;
    margin-bottom: 5px;
    background-color: rgb(29, 44, 53);
    border-width: 1px;
    border-color: rgba(215, 173, 75, 0.38);
    -unity-background-scale-mode: scale-and-crop;
}

.road-material-card .cf-button {
    min-height: 30px;
    margin-bottom: 0;
    padding-left: 5px;
    padding-right: 5px;
    font-size: 8px;
}

.road-material-marking-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.road-material-marking-row .cf-button {
    flex-grow: 1;
    min-height: 34px;
    margin-right: 5px;
    margin-bottom: 0;
    font-size: 8px;
}
.building-use-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 10px;
}

.building-use-tabs .cf-button {
    min-width: 118px;
    flex-grow: 1;
    margin-right: 5px;
    margin-bottom: 5px;
}

.cf-button--building-use-selected {
    background-color: rgb(66, 112, 88);
    border-left-color: rgb(220, 177, 68);
    border-right-color: rgb(220, 177, 68);
    border-top-color: rgb(220, 177, 68);
    border-bottom-color: rgb(220, 177, 68);
    color: rgb(244, 239, 218);
}

.cf-button--building-use {
    background-color: rgb(25, 43, 51);
    color: rgb(224, 219, 199);
}

.catalog-empty {
    margin-top: 8px;
    padding: 12px;
    background-color: rgba(26, 43, 50, 0.75);
    color: rgb(173, 169, 151);
    -unity-text-align: middle-center;
}

.lot-context-menu {
    width: 210px;
    padding: 8px;
    background-color: rgb(16, 29, 36);
    border-width: 1px;
    border-color: rgb(207, 166, 64);
}

.lot-context-menu .cf-button {
    min-height: 38px;
    margin-bottom: 5px;
}

.lot-context-menu .lot-context-delete {
    background-color: rgb(48, 65, 76);
    border-color: rgb(85, 105, 117);
}

.lot-context-menu .lot-context-delete:hover {
    background-color: var(--cf-danger-500);
    border-color: rgba(238, 231, 207, 0.42);
    color: white;
}

.lighting-direction-contract {
    color: rgb(232, 193, 86);
    font-size: 10px;
    margin-top: 3px;
    margin-bottom: 9px;
    white-space: normal;
}

.environment-lighting-control {
    min-height: 48px;
    margin-top: 3px;
    margin-bottom: 5px;
}

.environment-lighting-adjustment {
    flex-direction: row;
    align-items: center;
    height: 30px;
}

.environment-lighting-adjustment > .cf-button {
    width: 30px;
    min-width: 30px;
    height: 28px;
    min-height: 28px;
    margin: 0 4px 0 0;
    padding: 0;
}

.environment-lighting-slider {
    flex-grow: 1;
    min-width: 210px;
    height: 28px;
    min-height: 28px;
}

.environment-lighting-slider .unity-base-slider__input {
    height: 28px;
    min-height: 28px;
}

.environment-lighting-slider .unity-base-slider__tracker {
    height: 8px;
    background-color: rgb(22, 37, 45);
    border-width: 1px;
    border-color: rgb(95, 116, 124);
}

.environment-lighting-slider .unity-base-slider__dragger {
    width: 18px;
    height: 24px;
    background-color: rgb(221, 177, 67);
    border-width: 2px;
    border-color: rgb(245, 225, 153);
}

.building-prop-scale-stops {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2px;
    margin-bottom: 10px;
}

.building-prop-scale-stop {
    width: 34px;
    min-width: 34px;
    height: 27px;
    min-height: 27px;
    margin: 0;
    padding: 0;
    color: rgb(238, 231, 207);
    background-color: rgb(29, 48, 58);
    border-width: 1px;
    border-color: rgb(95, 116, 124);
    font-size: 10px;
}

.building-prop-scale-stop:hover {
    color: rgb(255, 244, 196);
    background-color: rgb(67, 82, 64);
    border-color: rgb(221, 177, 67);
}

/* Large, high-contrast explanations for every Region and District control. */
.region-hover-help-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 34px;
}

.region-hover-help {
    width: 720px;
    max-width: 82%;
    min-height: 76px;
    padding: 18px 26px;
    background-color: rgba(8, 23, 34, 0.96);
    border-width: 3px;
    border-color: rgb(232, 193, 86);
    border-radius: 12px;
}

.region-hover-help-text {
    color: rgb(255, 248, 220);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.district-lot-browser {
    width: 760px;
    max-width: 88%;
}

.district-lot-save-list {
    height: 500px;
    max-height: 58%;
    flex-shrink: 0;
}

.district-lot-entry {
