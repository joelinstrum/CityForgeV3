    font-size: 28px;
}

.district-lot-info-hint {
    margin-top: 12px;
    color: rgb(205, 218, 212);
    font-size: 12px;
    white-space: normal;
}

.district-loading-screen {
    background-color: rgb(7, 25, 37);
    align-items: center;
    justify-content: center;
}

.district-loading-panel {
    width: 520px;
    padding: 42px;
    background-color: rgba(13, 35, 45, 0.98);
    border-width: 2px;
    border-color: rgba(215, 173, 75, 0.75);
    border-radius: 12px;
    align-items: center;
}

.district-loading-kicker {
    color: rgb(215, 173, 75);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.district-loading-title {
    margin-top: 12px;
    color: rgb(255, 248, 220);
    font-size: 32px;
    -unity-font-style: bold;
}

.district-loading-name {
    margin-top: 8px;
    color: rgb(190, 207, 203);
    font-size: 14px;
    letter-spacing: 2px;
}

.district-loading-track {
    width: 100%;
    height: 8px;
    margin-top: 28px;
    background-color: rgb(5, 18, 27);
    border-radius: 4px;
    overflow: hidden;
}

.district-loading-fill {
    width: 72%;
    height: 100%;
    background-color: rgb(215, 173, 75);
    border-radius: 4px;
}

.district-loading-copy {
    margin-top: 16px;
    color: rgb(155, 178, 177);
    font-size: 12px;
}

/* Actual model portraits, with a bounded scrolling library on smaller Game views. */
.document-modal-panel.character-library-panel {
    width: 940px;
    max-width: 94%;
    height: 740px;
    max-height: 90%;
    padding: 20px;
}
.character-library-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-right: 6px;
}
.road-material-card.character-library-card {
    width: 204px;
    flex-shrink: 0;
    margin-right: 10px;
    margin-bottom: 12px;
}
.character-library-card .character-library-select {
    flex-direction: column;
    align-items: stretch;
    height: 184px;
    padding: 5px;
}
.character-library-image {
    width: 100%;
    height: 138px;
    flex-shrink: 0;
}
.character-library-name {
    height: 30px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 10px;
    color: rgb(238, 231, 209);
}
.character-library-card .catalog-meta {
    white-space: normal;
    margin-top: 6px;
}
.character-library-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
}
.character-library-scroll .unity-scroll-view__content-container,
.character-library-scroll .road-material-grid,
.character-library-scroll .road-material-role {
    flex-shrink: 0;
}
.character-library-card .character-library-select {
    min-height: 184px;
    flex-shrink: 0;
}
.road-material-card.character-library-card {
    min-height: 238px;
}
.character-library-name {
    flex-shrink: 0;
}

/* Prop portraits use the character picker structure with readable item names. */
.document-modal-panel.character-library-panel.prop-library-panel {
    width: 1200px;
}
.prop-library-card .character-library-name {
    font-size: 16px;
    height: 44px;
}
.prop-library-card .character-library-select {
    height: 200px;
    min-height: 200px;
}
.prop-library-card .character-library-image {
    background-color: rgb(48, 61, 66);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.prop-library-card .catalog-meta {
    font-size: 12px;
    color: rgb(203, 209, 208);
}
.prop-library-card .character-library-select {
    width: 100%;
    min-width: 0;
}
.prop-library-panel > .document-modal-title,
.prop-library-panel > .document-modal-copy,
.prop-library-panel > .document-modal-actions {
    flex-shrink: 0;
}

/* Shared root-level choice popup: never inherits transparent native menu styling. */
Button.cf-choice-display { margin: 0; padding-left: 12px; padding-right: 12px; }
.cf-choice-option { flex-shrink: 0; }
.cf-choice-option:focus, .cf-choice-option.is-selected {
    color: rgb(248, 241, 217);
    background-color: rgb(62, 91, 73);
}


/* District notices and resource-site selection. */
.district-notice {
    position: absolute;
    left: 250px;
    right: 250px;
    bottom: 28px;
    background-color: var(--cf-ink-900);
    color: var(--cf-brass-300);
    border-radius: var(--cf-radius-md);
    padding: var(--cf-space-3) var(--cf-space-4);
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.industry-resource-card {
    flex-direction: row;
    align-items: center;
    padding: var(--cf-space-4);
    margin-bottom: var(--cf-space-3);
    background-color: var(--cf-ink-800);
    border-radius: var(--cf-radius-md);
}
.industry-resource-thumbnail {
    width: 250px;
    height: 180px;
    flex-shrink: 0;
    margin-right: var(--cf-space-4);
}
.industry-deposit-arrow {
    position: absolute;
    width: 56px;
    height: 62px;
    padding: 2px;
    margin: 0;
    border-width: 0;
    background-color: transparent;
    align-items: center;
    justify-content: center;
}
.industry-deposit-arrow:hover,
.industry-deposit-arrow:focus {
    background-color: rgba(71, 111, 82, 0.4);
    border-radius: var(--cf-radius-md);
}

/* Shared inspector actions use full labels instead of the former icon-only sizing. */
#selected-object-panel .district-lot-rotation-controls .cf-button {
    width: 130px;
    min-width: 130px;
    height: 44px;
    font-size: 14px;
    padding-left: 6px;
    padding-right: 6px;
    white-space: nowrap;
}
#selected-object-panel > .cf-button {
    width: 180px;
    min-width: 180px;
    white-space: nowrap;
}

/* Region map layers use a small anchored menu, with independent checkboxes. */
.region-layers-control { position: relative; flex-shrink: 0; }
.region-layers-menu {
    position: absolute; top: 46px; right: 0; width: 268px;
    padding: 12px; background-color: var(--cf-ink-900);
    border-width: 1px; border-color: var(--cf-brass-400); border-radius: 6px;
}
.cf-check-toggle {
    flex-direction: row-reverse; align-items: center;
    min-height: 40px; color: var(--cf-paper-100); font-size: 17px;
}
.cf-check-toggle > .unity-toggle__label { flex-grow: 1; min-width: 0; margin-left: 10px; }
.cf-check-toggle > .unity-base-field__input { flex-grow: 0; flex-shrink: 0; width: 28px; }
.cf-check-toggle .unity-toggle__checkmark {
    width: 24px; height: 24px; min-width: 24px; flex-shrink: 0;
    background-color: var(--cf-ink-800); border-width: 1px;
    border-color: var(--cf-brass-400); border-radius: 3px;
}
.cf-check-toggle-glyph { color: var(--cf-paper-100); font-size: 21px; -unity-text-align: middle-center; }
.cf-check-toggle:hover { background-color: var(--cf-ink-700); }
.region-layers-hint { color: var(--cf-paper-300); font-size: 12px; margin-left: 38px; margin-bottom: 4px; }
.region-map--neutral { background-color: rgb(57, 66, 66); }
.region-city-tile--map-hidden { border-color: transparent; background-color: transparent; }
.region-city-tile--map-hidden:hover { border-color: rgba(230, 215, 135, 0.75); background-color: transparent; }

.region-pike-toolbar {
    position: absolute; left: 24px; top: 94px; flex-direction: row; align-items: center;
    padding: 10px 16px; background-color: var(--cf-ink-900);
    border-width: 1px; border-color: var(--cf-brass-400); border-radius: 6px;
}
.region-pike-hint { color: var(--cf-paper-100); font-size: 16px; margin-right: 18px; }
.region-pike-pencil { position: absolute; color: var(--cf-brass-300); font-size: 34px; -unity-font-style: bold; }
.region-pike-name { color: var(--cf-paper-100); font-size: 24px; margin-top: 16px; margin-bottom: 16px; }
.region-pike-name > .unity-base-field__input { background-color: var(--cf-ink-700); color: var(--cf-paper-100); padding: 10px; }
.region-road-map-label {
    position: absolute; color: var(--cf-paper-100); font-size: 14px; white-space: nowrap;
    background-color: rgba(19, 28, 35, 0.85); padding: 3px 8px; border-radius: 4px;
    translate: -50% -100%;
}
.region-pike-toolbar .cf-button { white-space: nowrap; min-width: 140px; }

/* Labels live in screen-aligned anchors, independent of the ground projection. */
.region-horizontal-place-name {
    position: absolute; left: 0; top: -4px; bottom: auto;
    translate: -50% -100%;
}

.terraform-flyout--water { width: 210px; }
.terraform-tool-button--water { width: 186px; height: 46px; font-size: 18px; }
