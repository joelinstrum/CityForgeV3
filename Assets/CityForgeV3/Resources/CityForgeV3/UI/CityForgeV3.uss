}

.district-lot-info-name {
    margin-top: 6px;
    color: rgb(255, 248, 220);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.district-lot-info-meta {
    margin-top: 8px;
    color: rgb(205, 218, 212);
