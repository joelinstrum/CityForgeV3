    letter-spacing: 1px;
}

.district-selected-lot-panel {
    position: absolute;
    right: 24px;
    top: 92px;
    width: 340px;
    padding: 18px;
    background-color: rgba(8, 28, 42, 0.94);
    border-width: 2px;
    border-color: rgb(232, 193, 86);
    border-radius: 10px;
}

.district-lot-info-kicker {
    color: rgb(232, 193, 86);
    font-size: 12px;
