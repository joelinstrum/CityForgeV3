}

.terraform-district-name-field {
    margin-top: 5px;
    color: rgb(25, 46, 60);
    font-size: 16px;
}

.terraform-district-name-field .unity-base-field__label {
    min-width: 44px;
    color: rgb(55, 78, 88);
    font-size: 9px;
    letter-spacing: 1px;
}

.terraform-district-name-field .unity-base-text-field__input {
    min-height: 28px;
    padding-left: 7px;
    color: rgb(25, 46, 60);
    background-color: rgba(239, 247, 241, 0.76);
    border-width: 1px;
    border-color: rgba(55, 78, 88, 0.52);
}

.terraform-district-designation {
    margin-top: 6px;
    flex-direction: row;
}

.terraform-district-designation-button {
    height: 25px;
    margin-right: 5px;
    padding-left: 10px;
    padding-right: 10px;
    color: rgb(55, 78, 88);
    background-color: rgba(239, 247, 241, 0.56);
    border-width: 1px;
    border-color: rgba(55, 78, 88, 0.46);
    font-size: 9px;
    letter-spacing: 1px;
}

.terraform-district-designation-button--selected {
    color: white;
    background-color: rgb(67, 100, 164);
    border-color: rgb(235, 239, 218);
}

.terraform-district-meta {
    margin-top: 6px;
    color: rgb(55, 78, 88);
    font-size: 9px;
    letter-spacing: 1px;
}

.district-simulation-panel {
    position: absolute;
    right: 22px;
    bottom: 20px;
    width: 250px;
    padding: 16px 18px;
    background-color: rgba(7, 29, 48, 0.92);
    border-width: 2px;
    border-color: rgba(222, 180, 73, 0.90);
    border-radius: 18px;
}

.district-simulation-panel--embedded {
    position: relative;
    right: auto;
    bottom: auto;
    width: auto;
    margin-top: 12px;
    padding: 12px 14px;
}

.district-simulation-money {
    margin-bottom: 8px;
    color: rgb(238, 211, 128);
    font-size: 25px;
    -unity-font-style: bold;
}

.district-simulation-stat {
    margin-top: 2px;
    color: rgb(235, 241, 244);
    font-size: 15px;
}

.district-time-controls {
    margin-top: 13px;
    flex-direction: row;
}

.district-time-button {
    flex-grow: 1;
    height: 38px;
    margin: 0 4px 0 0;
    padding: 0;
    color: rgba(235, 241, 255, 0.74);
    background-color: rgb(31, 52, 72);
    border-width: 1px;
    border-color: rgb(80, 101, 117);
    border-radius: 7px;
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.district-time-button:hover {
    color: white;
    background-color: rgb(57, 83, 106);
    border-color: rgb(238, 211, 128);
}

.district-time-button--selected {
    color: white;
    background-color: rgb(67, 112, 78);
    border-color: rgb(122, 217, 139);
}

#district-simulation-pause.district-time-button--selected {
    background-color: rgb(132, 72, 48);
    border-color: rgb(240, 159, 101);
}

.district-simulation-status {
    margin-top: 8px;
    color: rgb(151, 176, 187);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.district-unfounded-label {
    margin-bottom: 12px;
    color: rgb(238, 211, 128);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.district-founder-hint {
    margin-top: 10px;
    color: rgb(164, 184, 193);
    font-size: 10px;
    white-space: normal;
}

.district-founder-name {
    margin-top: 7px;
    color: rgb(238, 211, 128);
    font-size: 9px;
    letter-spacing: 1px;
}

.district-founder-placement-name {
    margin-bottom: 4px;
    color: rgb(248, 239, 208);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.founder-modal {
    width: 880px;
    height: 680px;
    padding: 28px 34px;
    background-color: rgb(8, 39, 68);
    border-width: 3px;
    border-color: rgb(222, 180, 73);
    border-radius: 24px;
}

.founder-modal-title {
    color: rgb(248, 239, 208);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.founder-modal-intro {
    margin: 10px 28px 18px;
    color: rgb(190, 207, 216);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.founder-building-list {
    height: 500px;
    margin-bottom: 12px;
}

.founder-building-card {
    min-height: 104px;
    margin: 0 8px 10px 0;
    padding: 12px 16px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(15, 53, 85);
    border-width: 1px;
    border-color: rgba(222, 180, 73, 0.55);
    border-radius: 12px;
}

.founder-building-card:hover {
    background-color: rgb(24, 76, 111);
    border-color: rgb(242, 205, 105);
}

.founder-building-icon {
    width: 82px;
    height: 64px;
    margin-right: 18px;
    color: rgb(238, 211, 128);
    background-color: rgba(5, 25, 43, 0.72);
    border-width: 2px;
    border-color: rgb(222, 180, 73);
    border-radius: 8px;
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.founder-building-copy {
    flex-grow: 1;
}

.founder-building-name {
    color: rgb(248, 239, 208);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
}

.founder-building-description {
    margin-top: 5px;
    color: rgb(185, 205, 214);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.founder-house-marker {
    position: absolute;
    width: 56px;
    height: 56px;
}

.founder-house-roof {
    position: absolute;
    left: 12px;
    top: 5px;
    width: 32px;
    height: 32px;
    rotate: 45deg;
    border-left-width: 4px;
    border-top-width: 4px;
    border-color: rgb(255, 224, 94);
}

.founder-house-body {
    position: absolute;
    left: 11px;
    top: 24px;
    width: 35px;
    height: 27px;
    border-width: 4px;
    border-color: rgb(255, 224, 94);
    background-color: rgba(7, 29, 48, 0.34);
}

.founder-house-marker--cursor {
    opacity: 0.82;
}

.district-placed-lot {
    position: absolute;
    overflow: visible;
    background-color: rgba(70, 91, 45, 0.72);
    border-width: 2px;
    border-color: rgb(255, 218, 72);
}

.district-placed-lot--rendered {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-size: contain;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    rotate: -45deg;
    scale: 1 2.924;
    transform-origin: 50% 50%;
}

.district-lot-asset {
    position: absolute;
    background-size: contain;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
}

.district-lot-building {
    background-color: rgba(92, 62, 36, 0.30);
}

.district-lot-prop {
    background-color: rgba(79, 51, 27, 0.22);
}

.district-lot-palisade {
    background-color: rgb(105, 67, 34);
}

.district-placed-lot-name {
    position: absolute;
    left: -14px;
    right: -14px;
    top: 78px;
    color: rgb(255, 231, 139);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.region-save-list {
    height: 400px;
    max-height: 400px;
}

.region-save-entry {
    min-height: 86px;
    margin-bottom: 10px;
    padding: 12px;
    flex-direction: row;
    align-items: center;
    background-color: var(--cf-ink-800);
    border-width: 1px;
    border-color: var(--cf-ink-700);
}

.region-save-details {
    flex-grow: 1;
}

.region-save-entry-title {
    color: var(--cf-paper-100);
    font-size: 18px;
    -unity-font-style: bold;
}

.region-save-entry-meta {
    color: var(--cf-paper-300);
    font-size: 10px;
    letter-spacing: 1px;
    margin-top: 6px;
}

.cf-image-button {
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, opacity;
    transition-duration: 0.08s;
}

.cf-image-button--menu {
    width: 505px;
    height: 104px;
}

.cf-image-button:hover {
    scale: 1.025 1.025;
}

.cf-image-button:active {
    scale: 0.985 0.985;
}

.cf-image-button:disabled {
    opacity: 1;
}

.menu-utilities {
    position: absolute;
    right: 38px;
    bottom: 24px;
    flex-direction: row;
    align-items: flex-end;
}

.cf-image-button--utility {
    width: 82px;
    height: 82px;
    margin-left: 18px;
}

.cf-button {
    height: 48px;
    margin-bottom: 10px;
    padding-left: 18px;
    padding-right: 18px;
    color: var(--cf-paper-100);
    background-color: var(--cf-ink-800);
    border-width: 1px;
    border-color: var(--cf-ink-700);
    border-radius: var(--cf-radius-sm);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.cf-button:hover {
    background-color: var(--cf-ink-700);
    border-color: var(--cf-brass-400);
    color: white;
}

.cf-button:active {
    background-color: var(--cf-brass-400);
    color: var(--cf-ink-950);
}

.cf-button:focus {
    border-color: var(--cf-brass-300);
    border-width: 2px;
}

.cf-button:disabled {
    opacity: 0.32;
    color: var(--cf-paper-300);
}

.cf-button--primary {
    background-color: var(--cf-green-500);
    border-color: var(--cf-brass-400);
}

.cf-button--danger {
    background-color: var(--cf-danger-500);
    border-color: rgba(238, 231, 207, 0.42);
}

.cf-button--quiet {
    width: 132px;
    background-color: transparent;
    border-color: transparent;
}

.cf-button--mode-selected {
    background-color: rgb(53, 99, 86);
    border-top-color: rgb(203, 169, 92);
    border-right-color: rgb(203, 169, 92);
    border-bottom-color: rgb(203, 169, 92);
    border-left-color: rgb(203, 169, 92);
    color: rgb(245, 236, 205);
}

.cf-button--icon,
.cf-button--icon-selected {
    width: 46px;
    height: 46px;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 20px;
}

.cf-button--icon-selected {
    background-color: var(--cf-green-500);
    border-color: var(--cf-brass-400);
}

.camera-pan-button {
    opacity: 0.5;
    background-color: var(--cf-ink-800);
    border-color: var(--cf-ink-700);
    color: var(--cf-paper-100);
    transition-duration: 0s;
}

.camera-pan-button:hover {
    opacity: 0.5;
    background-color: var(--cf-ink-800);
    border-color: var(--cf-ink-700);
    color: var(--cf-paper-100);
}

.camera-pan-button.cf-button--icon-selected,
.camera-pan-button.cf-button--icon-selected:hover {
    opacity: 1;
    background-color: var(--cf-green-500);
    border-color: var(--cf-brass-400);
    color: rgb(245, 236, 205);
}

.lot-editor-screen {
    background-color: transparent;
}

.time-of-day-grade {
    position: absolute;
    left: 0;
    right: 0;
    top: 70px;
    bottom: 0;
}

.topbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 70px;
    padding: 10px 18px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 18, 23, 0.95);
    border-bottom-width: 1px;
    border-bottom-color: rgba(193, 155, 72, 0.45);
}

.topbar-title {
    flex-grow: 1;
    margin-left: 20px;
}

.topbar-heading {
    font-size: 17px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.topbar-caption {
    margin-top: 3px;
    color: var(--cf-paper-300);
    font-size: 9px;
    letter-spacing: 2px;
}

.topbar-actions {
    flex-direction: row;
}

.current-selection-chip {
    margin-right: 12px;
    padding: 7px 10px;
    color: var(--cf-paper-100);
    background-color: rgba(83, 126, 94, 0.72);
    border-width: 1px;
    border-color: rgba(215, 173, 75, 0.68);
    border-radius: 3px;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.topbar-actions .cf-button {
    margin-left: 8px;
    margin-bottom: 0;
}

.tool-rail {
    position: absolute;
    left: 18px;
    top: 92px;
    bottom: 18px;
    width: 82px;
    padding: 10px 8px 6px 8px;
    background-color: rgba(19, 28, 35, 0.94);
    border-width: 1px;
    border-color: rgba(193, 155, 72, 0.34);
    border-radius: var(--cf-radius-md);
}

.tool-rail-scroll {
    flex-grow: 1;
    min-height: 0;
}

.tool-rail-scroll .unity-scroll-view__content-container {
    align-items: center;
}

.tool-rail .cf-button {
    margin-bottom: 8px;
}

.cf-image-button--tool-category,
.cf-image-button--tool-category-selected {
    width: 64px;
    height: 62px;
    margin-bottom: 7px;
    padding: 0;
    background-color: rgba(30, 46, 56, 0.92);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: rgba(193, 155, 72, 0.22);
    border-radius: var(--cf-radius-sm);
}

.cf-image-button--tool-category-selected {
    background-color: rgba(62, 105, 86, 0.96);
    border-width: 2px;
    border-color: var(--cf-brass-300);
}

.tool-category-caption {
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    height: 14px;
    color: rgb(247, 237, 204);
    background-color: rgba(12, 18, 23, 0.82);
    font-size: 7px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.tool-category-sun {
    color: rgb(255, 215, 92);
    font-size: 32px;
    -unity-text-align: middle-center;
}

.tool-category-main {
    color: rgb(245, 236, 205);
    font-size: 28px;
    -unity-text-align: middle-center;
}

.tool-category-effects {
    color: rgb(134, 220, 236);
    font-size: 32px;
    -unity-text-align: middle-center;
}

.effects-card-icon {
    height: 54px;
    color: rgb(247, 214, 126);
    font-size: 34px;
    -unity-text-align: middle-center;
}

.cf-button--rotation-icon {
    height: 48px;
    min-width: 62px;
    padding: 0;
    color: rgb(245, 236, 205);
    font-size: 30px;
    -unity-text-align: middle-center;
}

.catalog {
    position: absolute;
    left: 104px;
    top: 92px;
    width: 250px;
    padding: 18px;
    background-color: rgba(19, 28, 35, 0.95);
    border-width: 1px;
    border-color: rgba(193, 155, 72, 0.34);
    border-radius: var(--cf-radius-md);
}

.catalog .section-label {
    -unity-text-align: upper-left;
}

.catalog-title {
    margin-bottom: 8px;
    font-size: 17px;
    white-space: normal;
    -unity-font-style: bold;
}

.catalog.building-catalog {
    width: 390px;
}

.building-library-modal {
    padding: 36px;
}

.catalog.building-catalog.building-library-modal-panel {
    position: relative;
    left: auto;
    top: auto;
    width: 900px;
    height: 760px;
    max-width: 92%;
    max-height: 90%;
    padding: 24px;
}

.building-library-close {
    position: absolute;
    right: 20px;
    top: 18px;
    width: 92px;
    height: 34px;
}

.building-card-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 8px;
    padding-right: 8px;
}

.building-card-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.building-card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.building-card {
    width: 168px;
    height: 142px;
    margin-right: 7px;
    margin-bottom: 8px;
    padding: 6px;
    background-color: rgb(24, 40, 47);
    border-width: 1px;
    border-color: rgba(193, 155, 72, 0.48);
    border-radius: 3px;
    color: rgb(244, 239, 218);
}

.building-card:hover {
    background-color: rgb(40, 67, 64);
    border-color: rgb(220, 177, 68);
}

.building-card-thumbnail {
    height: 96px;
    margin-bottom: 5px;
    background-color: rgba(9, 17, 22, 0.72);
